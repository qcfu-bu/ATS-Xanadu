#implfun
d0pat_fprint
( d0p, out ) =
let
#impltmp
g_print$out<>() = out
in//let
//
case+
d0p.node() of
//
|
D0Pid0(id0) =>
(print("D0Pid0("); print(id0); print(")"))
//
|
D0Pint(int) =>
(print("D0Pint("); print(int); print(")"))
|
D0Pchr(chr) =>
(print("D0Pchr("); print(chr); print(")"))
|
D0Pflt(flt) =>
(print("D0Pflt("); print(flt); print(")"))
|
D0Pstr(str) =>
(print("D0Pstr("); print(str); print(")"))
//
|
D0Paspt
(tknd, d0p1) =>
(print("D0Paspt("); print(tknd); print(";"); print(d0p1); print(")"))
//
|
D0Papps(d0ps) =>
(
  (print("D0Papps("); print(d0ps); print(")")))
//
|
D0Psarg
(tbeg,s0as,tend) =>
(print("D0Psarg("); print(tbeg); print(";"); print(s0as); print(";"); print(tend); print(")"))
//
|
D0Plpar
(tbeg,t0ps,tend) =>
(print("D0Plpar("); print(tbeg); print(";"); print(t0ps); print(";"); print(tend); print(")"))
//
|
D0Ptup1
(tbeg,topt,d0ps,tend) =>
(
print("D0Ptup1(");
(print(tbeg); print(";"); print(topt); print(";"); print(d0ps); print(";"); print(tend); print(")")))
|
D0Prcd2
(tbeg,topt,ldps,tend) =>
(
print("D0Prcd2(");
(print(tbeg); print(";"); print(topt); print(";"); print(ldps); print(";"); print(tend); print(")")))
//
|
D0Pannot(d0p1,s0e2) =>
(print("D0Pannot("); print(d0p1); print(";"); print(s0e2); print(")"))
//
|
D0Ptkerr(tok) => (print("D0Ptkerr("); print(tok); print(")"))
|
D0Perrck // HX: generated by [pread00]
(lvl1(*err-level*),d0p2) => (print("D0Perrck("); print(lvl1); print(";"); print(d0p2); print(")"))
//
end (*let*) // end of [d0pat_fprint(d0p,out)]

