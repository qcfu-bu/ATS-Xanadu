#implfun
d0exp_THEN_fprint
  ( gthn, out ) =
(
case+ gthn of
|
d0exp_THEN_none(tok) =>
(print("d0exp_THEN_none("); print(tok); print(")"))
|
d0exp_THEN_some(tok,d0e) =>
(print("d0exp_THEN("); print(tok); print(";"); print(d0e); print(")"))
) where
{
#impltmp g_print$out<>() = out
} (*where*) // end of [d0exp_THEN_fprint(...)]
