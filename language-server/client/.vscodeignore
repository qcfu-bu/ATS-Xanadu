# Dev cruft — keep it out of the packaged .vsix.
.vscode/**
.gitignore
src/**
scripts/**
fixtures/**
out/**
**/*.ts
**/*.map
tsconfig.json
.vscodeignore

# All node_modules: the client is bundled into dist/extension.js by esbuild
# (vscode-languageclient is inlined), and the server ships as self-contained
# native binaries, so no node_modules are needed at runtime.
node_modules/**

# Esbuild can emit a meta/analysis file; never ship it.
dist/**/*.txt

# --- Included payload (these must ship) ---
# The bundled extension entrypoint.
!dist/extension.js
# The native server + check-only compiler driver, staged into server-dist/
# at package time by `npm run stage:server`.
!server-dist/**
